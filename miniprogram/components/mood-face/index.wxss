.mf {
  position: relative;
  flex-shrink: 0;
  transition: transform 0.35s cubic-bezier(0.34, 1.36, 0.64, 1), opacity 0.3s ease;
}

.mf-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mood);
  box-sizing: border-box;
  border: 4rpx solid transparent;
  transition: border-color 0.3s ease, background-color 0.3s ease;
}

/* 小人头像：浅色心情底，选中时加一圈心情色 */
.has-avatar .mf-circle {
  background: var(--soft);
}

.mf-img {
  width: 100%;
  height: 100%;
}

.sel .mf-circle {
  border-color: var(--mood);
}

.sel {
  transform: scale(1.1);
}

/* 选择器里没选中的：图标版是描边圆，小人版变淡 */
.muted.icon-only .mf-circle {
  background: transparent;
  border: 2rpx solid #d5dce2;
}

.muted.has-avatar {
  opacity: 0.55;
}

.mf-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  background: var(--mood);
  border: 4rpx solid #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: badge-in 0.4s cubic-bezier(0.34, 1.36, 0.64, 1) 0.2s backwards;
}

@keyframes badge-in {
  from {
    transform: scale(0);
  }
  to {
    transform: scale(1);
  }
}

/* ---------- 每种心情的出场动效 ---------- */
.play.mf-great .mf-circle {
  animation: mf-bounce 0.9s cubic-bezier(0.34, 1.36, 0.64, 1);
}

.play.mf-happy .mf-circle {
  animation: mf-nod 0.8s ease-in-out;
}

.play.mf-calm .mf-circle {
  animation: mf-sway 1.6s ease-in-out;
}

.play.mf-sad .mf-circle {
  animation: mf-droop 1.4s ease-in-out;
}

.play.mf-angry .mf-circle {
  animation: mf-shake 0.6s ease-in-out;
}

@keyframes mf-bounce {
  0%,
  100% {
    transform: none;
  }
  25% {
    transform: translateY(-14%) scale(1.04);
  }
  50% {
    transform: translateY(0) scale(0.97, 1.03);
  }
  70% {
    transform: translateY(-7%);
  }
}

@keyframes mf-nod {
  0%,
  100% {
    transform: none;
  }
  40% {
    transform: translateY(4%) rotate(-3deg);
  }
  70% {
    transform: translateY(-2%) rotate(1deg);
  }
}

@keyframes mf-sway {
  0%,
  100% {
    transform: none;
  }
  30% {
    transform: rotate(-4deg);
  }
  70% {
    transform: rotate(4deg);
  }
}

@keyframes mf-droop {
  0%,
  100% {
    transform: none;
  }
  45%,
  70% {
    transform: translateY(6%) rotate(-5deg) scale(0.97);
  }
}

@keyframes mf-shake {
  0%,
  100% {
    transform: none;
  }
  15%,
  55% {
    transform: translateX(-6%) rotate(-3deg);
  }
  35%,
  75% {
    transform: translateX(6%) rotate(3deg);
  }
}
