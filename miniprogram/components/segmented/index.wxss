.seg {
  position: relative;
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #E4EAEF;
}

.seg-thumb {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(27, 30, 37, 0.06), 0 8rpx 20rpx -10rpx rgba(27, 30, 37, 0.25);
  transition: transform 0.42s cubic-bezier(0.34, 1.2, 0.64, 1);
}

.seg-item {
  position: relative;
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #555b69;
  transition: color 0.3s ease, transform 0.2s cubic-bezier(0.34, 1.36, 0.64, 1);
}

.seg-item.on {
  color: #1b1e25;
  font-weight: 600;
}

.seg-item.pressed {
  transform: scale(0.95);
}

.seg-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  margin-left: 8rpx;
  border-radius: 16rpx;
  background: #1F8BC1;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  animation: badge-pop 0.4s cubic-bezier(0.34, 1.36, 0.64, 1);
}

@keyframes badge-pop {
  from {
    transform: scale(0.4);
  }
  to {
    transform: scale(1);
  }
}
