/* 选中的那个放大并加一圈心情色，其他的淡下去 */
.moods {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
}

.mood {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
  transition: transform 0.3s cubic-bezier(0.34, 1.36, 0.64, 1), opacity 0.3s ease;
}

.mood.pressed {
  transform: scale(0.9);
}

.mood-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9a9ea8;
  transition: color 0.3s ease;
}

.mood.on .mood-label {
  color: #1b1e25;
  font-weight: 600;
}
