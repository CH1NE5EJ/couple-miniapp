.head {
  padding: 8rpx 4rpx 28rpx;
}

.head-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.head-big {
  font-size: 104rpx;
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: -4rpx;
  color: var(--accent-deep);
}

.head-of {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}

.head-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.head-meta .num {
  color: var(--ink);
  font-weight: 600;
}

.dot {
  margin: 0 12rpx;
}

.map-card {
  padding: 24rpx;
}

.map-canvas {
  display: block;
  width: 100%;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.legend-item {
  display: flex;
  align-items: center;
}

.sw {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.sw0 {
  background: #e2e7eb;
}

.sw1 {
  background: #a0d4ee;
}

.sw2 {
  background: #5cb4e0;
}

.sw3 {
  background: #1f8bc1;
}

.map-tip {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
}

/* 选中省份的信息条：从地图下方展开 */
.sel {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: translateY(-16rpx) scale(0.98);
  transition: max-height 0.45s var(--ease), opacity 0.3s var(--ease), transform 0.45s var(--ease),
    margin 0.45s var(--ease);
}

.sel.on {
  max-height: 200rpx;
  opacity: 1;
  transform: none;
  margin-top: 20rpx;
}

.sel-inner {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 32rpx;
  border-radius: 28rpx;
  background: var(--accent);
  color: #fff;
}

.sel-name {
  font-size: 32rpx;
  font-weight: 600;
}

.sel-count {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.sel-btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: var(--accent-deep);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  transition: transform 0.22s var(--spring);
}

.sel-btn.pressed {
  transform: scale(0.92);
}

.sel-close {
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s var(--spring);
}

.sel-close.pressed {
  transform: scale(0.88) rotate(90deg);
}

/* 朋友圈式动态卡片：名字、文字、九宫格、地点、时间（不显示头像，内容占满卡片宽度） */
.post {
  display: flex;
  padding: 28rpx 28rpx 24rpx;
}

.post-main {
  min-width: 0;
}

.post-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

/* 记录文字最多 4 行，完整的在详情里 */
.post-note {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.post-grid {
  display: block;
  margin-top: 16rpx;
}

.post-loc {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--accent-deep);
}

.post-loc-icon {
  margin-right: 6rpx;
  flex-shrink: 0;
}

.post-foot {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  min-height: 44rpx;
}

.post-when {
  min-width: 0;
  font-size: 22rpx;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-dot {
  margin: 0 8rpx;
}

.post-reviews {
  display: flex;
  gap: 6rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
