.photo {
  position: relative;
  height: 360rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--accent-soft);
  margin-bottom: 20rpx;
  transition: transform 0.25s var(--spring);
}

.photo.pressed {
  transform: scale(0.98);
}

.photo-img {
  width: 100%;
  height: 100%;
  animation: fade 0.4s ease backwards;
}

.photo-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--accent-deep);
}

.photo-x {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(27, 30, 37, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.learn-row {
  display: flex;
  gap: 16rpx;
}

/* 学会/没学会：整块翻成藏青 */
.learn-card {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--bg);
  transition: background-color 0.35s var(--ease), transform 0.25s var(--spring);
}

.learn-card.pressed {
  transform: scale(0.95);
}

.learn-card.on {
  background: var(--accent);
}

.learn-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  transition: color 0.35s var(--ease);
}

.learn-state {
  font-size: 22rpx;
  color: var(--ink-3);
  transition: color 0.35s var(--ease);
}

.on .learn-name {
  color: #fff;
}

.on .learn-state {
  color: rgba(255, 255, 255, 0.7);
}
