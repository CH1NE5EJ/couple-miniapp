.date-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: var(--surface);
  box-shadow: var(--shadow);
  transition: transform 0.25s var(--spring);
}

.date-row.pressed {
  transform: scale(0.985);
}

.date-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.bonus {
  font-size: 22rpx;
  color: var(--accent-deep);
  background: var(--accent-soft);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.events {
  margin-bottom: 16rpx;
}

.chip-x {
  margin-left: 8rpx;
}

.add-row {
  display: flex;
  align-items: center;
  padding: 8rpx 8rpx 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--bg);
}

.add-input {
  flex: 1;
  height: 56rpx;
  font-size: 26rpx;
}

.add-btn {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  color: var(--ink-3);
  transition: background-color 0.25s var(--ease), color 0.25s var(--ease), transform 0.2s var(--spring);
}

.add-btn.on {
  background: var(--accent);
  color: #fff;
}

.add-btn.pressed {
  transform: scale(0.92);
}

/* 照片九宫格（和记录足迹页一致） */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cell {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  padding-top: calc((100% - 24rpx) / 3);
  height: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--accent-soft);
  transition: transform 0.25s var(--spring);
}

.cell.pressed {
  transform: scale(0.94);
}

.cell-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.add-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  margin: -24rpx 0 0 -24rpx;
}

.cell-x {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(27, 30, 37, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}
