<view class="page">
  <view class="head enter">
    <view class="eyebrow">吃过的</view>
    <view class="title-xl">一起吃过 <text class="num">{{list.length}}</text> 顿</view>
  </view>

  <view class="timeline">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="tl-item enter"
      style="animation-delay: {{80 + (index < 12 ? index : 12) * 50}}ms"
    >
      <view class="tl-rail">
        <view class="tl-dot {{item.done ? 'on' : ''}}" />
      </view>
      <view class="card tl-card grow">
        <view class="between">
          <view class="tl-day">
            <text>{{item.day}}</text>
            <text class="tl-week">{{item.week}}</text>
          </view>
          <text class="tl-ago">{{item.ago}}</text>
        </view>
        <view class="tl-dishes">
          <text wx:for="{{item.dishes}}" wx:for-item="d" wx:key="*this" class="tag plain">{{d}}</text>
        </view>
        <view wx:if="{{item.by}}" class="tl-by">{{item.by}} 点的{{item.done ? '' : ' · 没有确认'}}</view>
      </view>
    </view>
  </view>

  <ui-empty wx:if="{{loaded && !list.length}}" icon="history" title="还没有记录" desc="每天点过的菜会自动留在这里" />
</view>
