.head {
  padding: 8rpx 4rpx 28rpx;
}

.head-unit {
  margin-left: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.cat-scroll {
  width: auto;
  margin: 0 -32rpx;
  padding: 0 32rpx;
  white-space: nowrap;
}

.cat-scroll .chips {
  display: inline-flex;
  padding-right: 32rpx;
}

.done-toggle {
  display: inline-flex;
  align-items: center;
  margin: 28rpx 4rpx 20rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  transition: opacity 0.2s;
}

.done-toggle.pressed {
  opacity: 0.6;
}

.mini-switch {
  position: relative;
  width: 60rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: var(--line-2);
  margin-right: 12rpx;
  transition: background-color 0.3s var(--ease);
}

.mini-switch.on {
  background: var(--accent);
}

.mini-knob {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: #fff;
  transition: transform 0.35s var(--spring);
}

.on .mini-knob {
  transform: translateX(24rpx);
}

/* 计划卡片 */
.plan {
  padding: 28rpx 28rpx 24rpx;
}

.plan-top {
  display: flex;
  align-items: flex-start;
}

/* 圆圈勾选：背景填充 + 勾号弹出 */
.check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--line-2);
  margin: 2rpx 20rpx 0 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease), transform 0.25s var(--spring);
}

.check.pressed {
  transform: scale(0.86);
}

.check.on {
  background: var(--accent);
  border-color: var(--accent);
}

.check-mark {
  opacity: 0;
  transform: scale(0.3) rotate(-30deg);
}

.check.on .check-mark {
  opacity: 1;
  transform: none;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  transition: color 0.3s var(--ease);
}

.is-done .plan-title {
  color: var(--ink-3);
  text-decoration: line-through;
}

.plan-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.plan-due {
  font-size: 22rpx;
  color: var(--ink-3);
}

.plan-due.overdue {
  color: var(--wine);
}

.chev {
  padding: 4rpx 0 0 12rpx;
  transition: transform 0.4s var(--ease);
}

.is-open .chev {
  transform: rotate(180deg);
}

.plan-progress {
  display: flex;
  align-items: center;
  margin: 20rpx 0 0 68rpx;
}

.plan-count {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.plan-more {
  overflow: hidden;
  margin-left: 68rpx;
  transition: max-height 0.45s var(--ease);
}

.plan-desc {
  padding-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.sub-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  border-bottom: 1rpx solid var(--line);
  transition: opacity 0.2s;
}

.sub-row.pressed {
  opacity: 0.6;
}

.sub-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 3rpx solid var(--line-2);
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease);
}

.sub-row.on .sub-box {
  background: var(--accent);
  border-color: var(--accent);
}

.sub-mark {
  opacity: 0;
  transform: scale(0.3);
}

.sub-row.on .sub-mark {
  opacity: 1;
  transform: none;
}

.sub-text {
  font-size: 28rpx;
  transition: color 0.25s;
}

.sub-row.on .sub-text {
  color: var(--ink-3);
  text-decoration: line-through;
}

.plan-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 24rpx;
}

.act {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: var(--bg);
  font-size: 24rpx;
  transition: transform 0.22s var(--spring);
}

.act.pressed {
  transform: scale(0.92);
}

.act-main {
  background: var(--accent);
  color: #fff;
}

.act-icon {
  margin-right: 8rpx;
}

/* ---------- 计划 / 任务 切换 ---------- */
.mode-seg {
  margin-bottom: 24rpx;
}

.from-right {
  animation: from-right 0.45s var(--ease) backwards;
}

.from-left {
  animation: from-left 0.45s var(--ease) backwards;
}

@keyframes from-right {
  from {
    opacity: 0;
    transform: translate3d(48rpx, 0, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes from-left {
  from {
    opacity: 0;
    transform: translate3d(-48rpx, 0, 0);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* ---------- 任务 ---------- */
.favs-label {
  margin: 0 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.fav-scroll {
  margin: 0 -32rpx;
  padding: 0 32rpx;
  width: auto;
  white-space: nowrap;
}

.fav-scroll .chips {
  display: inline-flex;
  padding-right: 32rpx;
}

.fav-chip {
  border-color: var(--wine-soft);
}

.fav-pts {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--accent-deep);
  font-weight: 600;
}

.task {
  padding: 24rpx 24rpx 24rpx 24rpx;
}

.card.task + .card.task {
  margin-top: 16rpx;
}

.task-top {
  display: flex;
  align-items: center;
}

/* 分值做成一枚圆章 */
.task-pts {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.is-done .task-pts {
  background: var(--accent);
  color: #fff;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
}

.is-done .task-title {
  color: var(--ink-3);
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.task-by {
  font-size: 22rpx;
  color: var(--ink-3);
}

.task-star {
  padding: 12rpx;
  transition: transform 0.3s var(--spring);
}

.task-star.pressed {
  transform: scale(0.8) rotate(-15deg);
}

.task-note {
  margin: 16rpx 0 0 104rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.task-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.task-wait {
  flex: 1;
  font-size: 22rpx;
  color: var(--ink-3);
}
