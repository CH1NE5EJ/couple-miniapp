.intro {
  margin-top: 16rpx;
  line-height: 1.7;
}

.notice-icon {
  margin-right: 12rpx;
}

.retry {
  margin-left: 16rpx;
  font-weight: 600;
}

.who {
  display: flex;
  gap: 20rpx;
}

/* 身份卡：选中时底色、头像、勾选标记一起过渡 */
.who-card {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 36rpx 28rpx 32rpx;
  border-radius: 32rpx;
  background: var(--surface);
  box-shadow: var(--shadow);
  border: 2rpx solid transparent;
  transition: transform 0.3s var(--spring), border-color 0.3s var(--ease), background-color 0.3s var(--ease);
}

.who-card.pressed {
  transform: scale(0.96);
}

.who-card.on {
  border-color: var(--accent);
  background: #fbfbfd;
}

.who-card.taken {
  opacity: 0.5;
}

.who-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.35s var(--ease), color 0.35s var(--ease), transform 0.45s var(--spring);
}

.on .who-avatar {
  background: var(--accent);
  color: #fff;
  transform: scale(1.06);
}

.who-name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.who-state {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.who-check {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.4);
  transition: opacity 0.25s ease, transform 0.4s var(--spring);
}

.on .who-check {
  opacity: 1;
  transform: scale(1);
}

.locked-zone {
  transition: opacity 0.35s var(--ease);
}

.locked-zone.locked {
  opacity: 0.35;
  pointer-events: none;
}

.data-title {
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.data-desc {
  margin-top: 12rpx;
  line-height: 1.6;
  word-break: break-all;
}

.clear {
  font-size: 22rpx;
  color: var(--accent-deep);
  margin-bottom: 12rpx;
}

/* 微信通知：开启后铃铛底色填满，条数用完的那类变淡 */
.notify-bell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  transition: background-color 0.4s var(--ease), transform 0.5s var(--spring);
}

.notify-card.on .notify-bell {
  background: var(--accent);
  animation: bell-ring 0.9s var(--ease) 0.45s both;
}

@keyframes bell-ring {
  0% { transform: rotate(0); }
  20% { transform: rotate(-14deg); }
  40% { transform: rotate(11deg); }
  60% { transform: rotate(-6deg); }
  80% { transform: rotate(3deg); }
  100% { transform: rotate(0); }
}

.notify-label {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.notify-counts {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.notify-count {
  flex: 1;
  padding: 20rpx 0 18rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  text-align: center;
  transition: background-color 0.35s var(--ease), opacity 0.35s var(--ease), transform 0.35s var(--spring);
}

.notify-count.empty {
  background: var(--line);
  opacity: 0.7;
}

.notify-n {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent-deep);
  transition: color 0.35s var(--ease);
}

.notify-count.empty .notify-n {
  color: var(--ink-3);
}

.notify-unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
}

.notify-k {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.notify-hint {
  margin-top: 20rpx;
  line-height: 1.6;
  font-size: 24rpx;
}

.notify-btn {
  margin-top: 28rpx;
}

.notify-other {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--ink-2);
}

.notify-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--line-2);
  transition: background-color 0.35s var(--ease), transform 0.35s var(--spring);
}

.notify-dot.on {
  background: var(--accent);
  transform: scale(1.2);
}
