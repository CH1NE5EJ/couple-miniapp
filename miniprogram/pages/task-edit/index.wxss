.status {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 24rpx;
}

.status-icon {
  margin-right: 10rpx;
}

.pts-input {
  margin-top: 16rpx;
  font-size: 28rpx;
}

.hint {
  margin-top: 14rpx;
  font-size: 22rpx;
}

/* 锁住的字段整体变淡，点了也不响应 */
.field.locked {
  opacity: 0.45;
  pointer-events: none;
  transition: opacity 0.3s var(--ease);
}

.lock-text {
  margin: -8rpx 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}
